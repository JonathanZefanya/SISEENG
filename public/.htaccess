# =========================================================
# SISTEM INFORMASI MANAJEMEN GEREJA (SISEENG)
# Apache URL Rewriting
# =========================================================

# Aktifkan URL rewriting
RewriteEngine On

# Set base directory
RewriteBase /project-website/siseeng/public/

# Jika file atau direktori ada, jangan rewrite
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect semua request ke index.php
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]

# =========================================================
# SECURITY HEADERS
# =========================================================
<IfModule mod_headers.c>
    # Mencegah clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Mencegah MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Aktifkan XSS protection di browser
    Header always set X-XSS-Protection "1; mode=block"
    
    # Referrer policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# =========================================================
# DISABLE DIRECTORY LISTING
# =========================================================
Options -Indexes

# =========================================================
# PROTECT SENSITIVE FILES
# =========================================================
<FilesMatch "\.(env|config|ini|log|sql)$">
    Order allow,deny
    Deny from all
</FilesMatch>
